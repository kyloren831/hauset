# Copia a .env.dev (o .env) y completa. Nunca subas el archivo real al repositorio.
# Secreto JWT: Base64 de al menos 32 bytes -> openssl rand -base64 48
APP_JWTSECRET=
# Llave de las contraseñas de los equipos (AES-256): openssl rand -base64 32
# Guárdala aparte del respaldo de la base: sin ella las contraseñas no se pueden leer.
HAUSET_CREDENCIALES_LLAVE=
# Interfaz de escucha del backend en desarrollo (por ejemplo la IP de Tailscale de la VPS)
SERVER_ADDRESS=127.0.0.1
# Clave del rol postgres. La usan docker compose (POSTGRES_PASSWORD) y el backend (SPRING_DATASOURCE_PASSWORD).
POSTGRES_PASSWORD=
SPRING_DATASOURCE_PASSWORD=
# Solo para una base nueva sin jefes: crea el primer jefe al arrancar. Quítalas después.
HAUSET_PRIMER_JEFE_TELEFONO=
HAUSET_PRIMER_JEFE_NOMBRE=
HAUSET_PRIMER_JEFE_PASSWORD=
# Archivos (fotos, firmas, PDF): DISCO_LOCAL (por defecto) o R2. Con R2, al arrancar se copian al bucket
# los que siguen en disco (el disco no se borra). Un bucket privado por entorno; token solo para ese bucket.
STORAGE_PROVEEDOR=DISCO_LOCAL
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
