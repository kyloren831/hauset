# Copia a .env.dev (o .env) y completa. Nunca subas el archivo real al repositorio.
# Secreto JWT: Base64 de al menos 32 bytes -> openssl rand -base64 48
APP_JWTSECRET=
# Llave de las contraseñas de los equipos (AES-256): openssl rand -base64 32
# Guárdala aparte del respaldo de la base: sin ella las contraseñas no se pueden leer.
HAUSET_CREDENCIALES_LLAVE=
# Interfaz de escucha del backend en desarrollo (por ejemplo la IP de Tailscale de la VPS)
SERVER_ADDRESS=127.0.0.1
