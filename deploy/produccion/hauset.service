# /etc/systemd/system/hauset.service
[Unit]
Description=Hauset (backend)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=hauset
Group=hauset
EnvironmentFile=/etc/hauset/hauset.env
WorkingDirectory=/opt/hauset
# Si se queda sin memoria se cierra y systemd lo levanta de nuevo, en vez de quedar a medias.
ExecStart=/usr/bin/java -Xms256m -Xmx1g -XX:+ExitOnOutOfMemoryError -jar /opt/hauset/hauset.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

# Endurecimiento: solo puede escribir en la carpeta de archivos.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hauset
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
