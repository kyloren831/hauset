# /etc/hauset/hauset.env  (dueño root, permisos 600: systemd lo lee como root). Nunca va al repositorio.
# Genera claves NUEVAS para producción; no reutilices las de desarrollo ni las de stage.

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/app_domotica
SPRING_DATASOURCE_USERNAME=hauset
# La misma que POSTGRES_PASSWORD en /etc/hauset/postgres.env:  openssl rand -base64 24
SPRING_DATASOURCE_PASSWORD=

# Secreto JWT:  openssl rand -base64 48
APP_JWTSECRET=
# Llave de las contraseñas de los equipos:  openssl rand -base64 32
# Guárdala fuera de la VPS y aparte de los respaldos: sin ella las contraseñas no se pueden leer,
# y quien tenga respaldo + llave puede leerlas todas.
HAUSET_CREDENCIALES_LLAVE=

# Solo Caddy (en la misma máquina) habla con el backend.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native
STORAGE_DISK_PATH=/var/lib/hauset/storage

# Archivos en Cloudflare R2 (bucket privado solo de producción, p. ej. hauset-produccion).
# Token de API de R2 con "Object Read & Write" limitado a ese bucket.
STORAGE_PROVEEDOR=R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Solo para el primer arranque (base sin jefes): crea el primer jefe de sistemas.
# Cuando entre a la app, borra estas tres líneas y reinicia:  systemctl restart hauset
HAUSET_PRIMER_JEFE_TELEFONO=
HAUSET_PRIMER_JEFE_NOMBRE=
HAUSET_PRIMER_JEFE_PASSWORD=
